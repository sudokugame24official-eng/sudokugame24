# -----------------------------------------------------------------------------
# SUDOKU PLATFORM - STAGING (BETA) ENVIRONMENT
# -----------------------------------------------------------------------------

# --- DATABASE (Neon STAGING Branch) ---
# DANGER: NEVER point this to the Production branch!
DATABASE_URL="postgresql://staging_user:staging_password@ep-staging-branch.eu-central-1.aws.neon.tech/sudoku_staging?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://staging_user:staging_password@ep-staging-branch.eu-central-1.aws.neon.tech/sudoku_staging?schema=public"

# --- REDIS (Upstash STAGING Database) ---
REDIS_URL="rediss://default:staging_token@staging-redis.upstash.io:30000"

# --- AUTHENTICATION ---
JWT_SECRET="generate-secure-random-string-for-staging"
JWT_EXPIRATION="1h"

# --- STRIPE (Test Mode STRICTLY) ---
# DANGER: Do NOT use Live keys here.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# --- OAUTH ---
GOOGLE_CLIENT_ID="staging-google-client-id"
GOOGLE_CLIENT_SECRET="staging-google-client-secret"
GOOGLE_CALLBACK_URL="https://api-staging.APP_DOMAIN/auth/google/callback"

# --- APPLICATION URLS (Cloudflare / Vercel / Railway) ---
NEXT_PUBLIC_API_URL="https://api-staging.APP_DOMAIN"
NEXT_PUBLIC_WS_URL="wss://api-staging.APP_DOMAIN"
FRONTEND_URL="https://staging.APP_DOMAIN"

# --- OBSERVABILITY ---
NEXT_PUBLIC_SENTRY_DSN="https://...@o0.ingest.sentry.io/..."
SENTRY_AUTH_TOKEN="..."
