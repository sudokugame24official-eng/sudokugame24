# -----------------------------------------------------------------------------
# SUDOKU PLATFORM - PRODUCTION ENVIRONMENT
# -----------------------------------------------------------------------------
# DANGER: HIGHLY SENSITIVE. DO NOT COMMIT.

# --- DATABASE (Neon PRODUCTION Branch) ---
DATABASE_URL="postgresql://prod_user:prod_password@ep-prod-branch.eu-central-1.aws.neon.tech/sudoku_prod?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://prod_user:prod_password@ep-prod-branch.eu-central-1.aws.neon.tech/sudoku_prod?schema=public"

# --- REDIS (Upstash PRODUCTION Database) ---
REDIS_URL="rediss://default:prod_token@prod-redis.upstash.io:30000"

# --- AUTHENTICATION ---
JWT_SECRET="generate-secure-random-string-for-prod"
JWT_EXPIRATION="1h"

# --- STRIPE (Live Mode) ---
# DANGER: REAL FINANCIAL TRANSACTIONS
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_..."

# --- OAUTH ---
GOOGLE_CLIENT_ID="prod-google-client-id"
GOOGLE_CLIENT_SECRET="prod-google-client-secret"
GOOGLE_CALLBACK_URL="https://api.APP_DOMAIN/auth/google/callback"

# --- APPLICATION URLS ---
NEXT_PUBLIC_API_URL="https://api.APP_DOMAIN"
NEXT_PUBLIC_WS_URL="wss://api.APP_DOMAIN"
FRONTEND_URL="https://APP_DOMAIN"

# --- OBSERVABILITY ---
NEXT_PUBLIC_SENTRY_DSN="https://...@o0.ingest.sentry.io/..."
SENTRY_AUTH_TOKEN="..."
