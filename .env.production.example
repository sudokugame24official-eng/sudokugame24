# -----------------------------------------------------------------------------
# SUDOKUGAME24.COM — CONFIGURATION D'ENVIRONNEMENT DE PRODUCTION
# Hostinger KVM 4 VPS + Cloudflare + Cloudflare R2 Backups + Gmail SMTP
# -----------------------------------------------------------------------------

# --- NODE ENVIRONMENT ---
NODE_ENV=production
PORT=3001

# --- BASE DE DONNÉES (Conteneur Docker PostgreSQL 15) ---
POSTGRES_USER=sudoku_prod_admin
POSTGRES_PASSWORD=GENEREZ_UN_MOT_DE_PASSE_POSTGRES_TRES_FORT_ICI
POSTGRES_DB=sudokugame24_db
DATABASE_URL="postgresql://sudoku_prod_admin:GENEREZ_UN_MOT_DE_PASSE_POSTGRES_TRES_FORT_ICI@postgres:5432/sudokugame24_db?schema=public"

# --- CACHE & WEBSOCKETS (Conteneur Docker Redis 7) ---
REDIS_PASSWORD=GENEREZ_UN_MOT_DE_PASSE_REDIS_FORT_ICI
REDIS_URL="redis://:GENEREZ_UN_MOT_DE_PASSE_REDIS_FORT_ICI@redis:6379"

# --- SÉCURITÉ & AUTHENTIFICATION (JWT) ---
JWT_SECRET=GENEREZ_UNE_CLE_SECRETE_ALEATOIRE_DE_64_CARACTERES_MINIMUM
JWT_EXPIRATION="7d"

# --- ADRESSES URL DE PRODUCTION (ROUTAGE CLOUDFLARE) ---
NEXT_PUBLIC_SITE_URL="https://sudokugame24.com"
FRONTEND_URL="https://sudokugame24.com"
NEXT_PUBLIC_API_URL="https://sudokugame24.com/api"
NEXT_PUBLIC_WS_URL="wss://sudokugame24.com"

# --- SAUVEGARDES AUTOMATIQUES CHIFFRÉES (CLOUDFLARE R2) ---
# Clé secrète de chiffrement militaire AES-256-GCM (À conserver dans votre gestionnaire de mots de passe)
BACKUP_ENCRYPTION_KEY=GENEREZ_UNE_PHRASE_SECRETE_AES256_POUR_LES_BACKUPS

# Identifiants Cloudflare R2 (Jeton: sudokugame24-backup-token)
R2_ACCOUNT_ID=VOTRE_ACCOUNT_ID_CLOUDFLARE
R2_ACCESS_KEY_ID=VOTRE_ACCESS_KEY_ID_R2
R2_SECRET_ACCESS_KEY=VOTRE_SECRET_ACCESS_KEY_R2
R2_BUCKET_NAME=sudokugame24-backups

# (Optionnel) Webhook Discord ou Slack pour alerte immédiate en cas de problème de backup
BACKUP_WEBHOOK_URL=""

# --- E-MAILS TRANSACTIONNELS (GMAIL DÉDIÉ : sudokugame24.official@gmail.com) ---
# NOTE GMAIL : Activez la validation en 2 étapes sur le compte Google,
# puis créez un "Mot de passe d'application" (16 lettres sans espaces)
# depuis : https://myaccount.google.com/apppasswords
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="sudokugame24.official@gmail.com"
SMTP_PASS="VOTRE_MOT_DE_PASSE_APPLICATION_GMAIL_16_LETTRES"
EMAIL_FROM="SudokuGame24 <sudokugame24.official@gmail.com>"

# --- MONÉTISATION & PAIEMENTS (DÉSACTIVÉS PAR DÉFAUT AU LANCEMENT) ---
ENABLE_ADS=false
ADS_ENABLED=false
ENABLE_STRIPE=false
STRIPE_ENABLED=false
