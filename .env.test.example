# ==========================================
# TEST ENVIRONMENT VARIABLES (.env.test)
# ==========================================

# DATABASE
# Utilisée exclusivement par Jest pour `npm run test:integration`
DATABASE_URL="postgresql://test_user:test_password@localhost:5432/sudoku_test?schema=public"

# SECRETS
JWT_SECRET="test-jwt-secret-do-not-use-anywhere-else"

# STRIPE (MOCKS)
STRIPE_SECRET_KEY="sk_test_mock"
STRIPE_WEBHOOK_SECRET="whsec_mock"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_mock"

# APP URLS
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3001"
